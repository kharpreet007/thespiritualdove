---
/** A clearly marked block for content you still need to write. */
interface Props {
  label?: string;
}
const { label = 'Your words go here' } = Astro.props;
---
<div class="placeholder">
  <div class="placeholder__label">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z" /></svg>
    {label}
  </div>
  <slot />
</div>
