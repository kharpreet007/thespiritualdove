---
import Cover from './Cover.astro';
import Icon from './Icon.astro';
import { formatLocation, type Place } from '../lib/content';

interface Props {
  place: Place;
  headingLevel?: 'h2' | 'h3';
}
const { place, headingLevel = 'h2' } = Astro.props;
const d = place.data;
const href = `/places/${place.id}/`;
const Heading = headingLevel;
---
<article class="feature">
  <a class="feature__media" href={href} tabindex="-1" aria-hidden="true">
    <Cover cover={d.cover} ratio="4 / 3" />
    <span class="feature__badge">{d.category}</span>
  </a>
  <div class="feature__body">
    <p class="feature__loc"><Icon name="pin" size={16} /> {formatLocation(d)}</p>
    <Heading class="feature__title"><a href={href}>{d.title}</a></Heading>
    <p class="feature__excerpt">{d.excerpt}</p>
    <div class="feature__actions">
      <a class="btn btn--primary" href={href}>Discover {d.title} <Icon name="arrow-right" /></a>
      <span class="feature__links">
        <a href={`${href}#itinerary`}>Itinerary</a>
        <a href={`${href}#location`}>Location</a>
        <a href={`${href}#hotels`}>Hotels</a>
      </span>
    </div>
  </div>
</article>

<style>
  .feature {
    display: grid;
    overflow: hidden;
    border-radius: calc(var(--radius) * 1.4);
    background: var(--white);
    box-shadow: var(--shadow);
    transition: box-shadow 0.45s var(--ease);
  }
  .feature:hover {
    box-shadow: var(--shadow-lift);
  }
  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1.25fr 1fr;
    }
    .feature__media :global(.cover) {
      aspect-ratio: auto;
      height: 100%;
      min-height: 440px;
    }
  }
  .feature__media {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .feature:hover .feature__media :global(img) {
    transform: scale(1.03);
  }
  .feature__badge {
    position: absolute;
    left: 1.2rem;
    top: 1.2rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 253, 249, 0.94);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .feature__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.6rem, 4vw, 3rem);
  }
  .feature__loc {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.7rem;
    font-size: 0.92rem;
    color: var(--ink-faint);
  }
  .feature__title {
    font-size: var(--step-4);
    margin: 0 0 0.6rem;
  }
  .feature__title a {
    color: inherit;
    text-decoration: none;
  }
  .feature__excerpt {
    font-size: var(--step-0);
    color: var(--ink-soft);
    margin-bottom: 1.8rem;
  }
  .feature__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.4rem;
  }
  .feature__links {
    display: flex;
    gap: 1.1rem;
  }
  .feature__links a {
    font-size: 0.92rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.3rem 0;
  }
  .feature__links a:hover {
    color: var(--saffron-deep);
    text-decoration: underline;
  }
  @media (max-width: 479px) {
    .feature__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
