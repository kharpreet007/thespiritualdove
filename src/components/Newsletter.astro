---
import Icon from './Icon.astro';
import { site } from '../config/site';
const connected = Boolean(site.newsletter.formAction);
---
<section class="newsletter section" aria-labelledby="newsletter-title">
  <div class="container">
    <div class="newsletter__card reveal">
      <div class="newsletter__copy">
        <span class="newsletter__icon" aria-hidden="true"><Icon name="mail" size={22} /></span>
        <h2 id="newsletter-title">Letters from the Journey</h2>
        <p>
          An occasional letter with new travel stories, destination discoveries, and thoughtful reflections from the road. No noise,
          only what feels worth sharing.
        </p>
      </div>

      <form
        class="newsletter__form"
        action={connected ? site.newsletter.formAction : undefined}
        method="post"
        target={connected ? '_blank' : undefined}
        data-newsletter
        data-connected={String(connected)}
        novalidate={!connected}
      >
        <label class="visually-hidden" for="newsletter-email">Email address</label>
        <div class="newsletter__row">
          <input
            class="input"
            id="newsletter-email"
            name={site.newsletter.emailFieldName}
            type="email"
            autocomplete="email"
            placeholder="Your email address"
            required
          />
          <button class="btn btn--primary" type="submit">Subscribe</button>
        </div>
        <p class="newsletter__note" data-newsletter-status aria-live="polite">
          {
            connected
              ? 'You can unsubscribe at any time.'
              : 'Letters are not being sent yet. Nothing you enter here is stored.'
          }
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  import { site } from '../config/site';
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    if (form.dataset.connected === 'true') return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
      if (status) {
        status.innerHTML = `Thank you for your interest. The newsletter isn't open yet, so nothing has been saved. Follow <a href="${site.instagram.url}" target="_blank" rel="noopener">${site.instagram.handle}</a> for updates in the meantime.`;
        status.classList.add('is-info');
      }
    });
  });
</script>

<style>
  .newsletter__card {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(120% 140% at 100% 0%, #f2ddc6 0%, transparent 55%),
      radial-gradient(90% 120% at 0% 100%, #e1e6d8 0%, transparent 60%),
      var(--paper-2);
    border: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .newsletter__card {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
  .newsletter__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--white);
    color: var(--saffron);
    margin-bottom: 1.2rem;
  }
  .newsletter h2 {
    font-size: var(--step-3);
  }
  .newsletter__copy p {
    color: var(--ink-soft);
    margin: 0;
    max-width: 46ch;
  }
  .newsletter__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .newsletter__row .input {
    flex: 1 1 220px;
    border-radius: 999px;
    padding-inline: 1.3rem;
  }
  .newsletter__row .btn {
    flex: 0 0 auto;
  }
  @media (max-width: 479px) {
    .newsletter__row .btn {
      flex: 1 1 100%;
    }
  }
  .newsletter__note {
    margin: 0.9rem 0 0 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .newsletter__note.is-info {
    color: var(--ink-soft);
  }
</style>
