---
import DoveMark from './DoveMark.astro';
interface Props {
  tone?: 'dark' | 'light';
  href?: string;
}
const { tone = 'dark', href = '/' } = Astro.props;
---
<a href={href} class:list={['logo', `logo--${tone}`]} aria-label="The Spiritual Dove — home">
  <DoveMark size={42} class="logo__mark" />
  <span class="logo__text">
    <span class="logo__the">The</span>
    <span class="logo__name">Spiritual Dove</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }
  .logo--light {
    color: var(--white);
  }
  .logo__mark {
    color: var(--saffron);
    flex: none;
    transition: transform 0.6s var(--ease);
  }
  .logo--light .logo__mark {
    color: currentColor;
  }
  .logo:hover .logo__mark {
    transform: translateY(-2px) rotate(-4deg);
  }
  .logo__text {
    display: grid;
    line-height: 1;
  }
  .logo__the {
    font: 600 0.62rem/1 var(--font-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }
  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>
