---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../config/site';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="container site-header__inner">
    <Logo />
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="site-header__ig" href={site.instagram.url} target="_blank" rel="noopener" aria-label={`Instagram ${site.instagram.handle}`}>
      <Icon name="instagram" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden" data-menu-label>Open menu</span>
      <Icon name="menu" size={26} class="menu-toggle__open" />
      <Icon name="close" size={26} class="menu-toggle__close" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          nav.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu__foot">
      <p>{site.tagline}</p>
      <a href={site.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> {site.instagram.handle}</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close menu' : 'Open menu';
      header.classList.toggle('is-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-visible'));
        menu.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        menu.classList.remove('is-visible');
        setTimeout(() => (menu.hidden = true), 250);
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && setOpen(false));

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248, 244, 237, 0.88);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease), color 0.35s var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    position: relative;
    display: block;
    padding: 0.6rem 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: 999px;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.3rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--saffron);
    opacity: 0;
    transform: translateY(3px);
    transition: all 0.25s var(--ease);
  }
  .site-nav a:hover {
    color: var(--ink);
    background: rgba(42, 39, 36, 0.05);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }
  .site-nav a[aria-current='page']::after {
    opacity: 1;
    transform: none;
  }
  .site-header__ig {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    transition: all 0.2s var(--ease);
  }
  .site-header__ig:hover {
    color: var(--white);
    background: var(--saffron);
    border-color: var(--saffron);
  }

  /* Overlay variant (home hero) */
  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .site-header--overlay:not(.is-scrolled):not(.is-open) :global(.logo) {
    color: var(--white);
  }
  .site-header--overlay:not(.is-scrolled):not(.is-open) :global(.logo__mark) {
    color: var(--white);
  }
  .site-header--overlay:not(.is-scrolled):not(.is-open) .site-nav a,
  .site-header--overlay:not(.is-scrolled):not(.is-open) .site-header__ig,
  .site-header--overlay:not(.is-scrolled):not(.is-open) .menu-toggle {
    color: rgba(255, 253, 249, 0.92);
    border-color: rgba(255, 253, 249, 0.4);
  }
  .site-header--overlay:not(.is-scrolled):not(.is-open) .site-nav a:hover {
    background: rgba(255, 253, 249, 0.14);
    color: var(--white);
  }
  .site-header--overlay:not(.is-scrolled):not(.is-open) .site-nav a[aria-current='page']::after {
    background: var(--white);
  }
  .site-header--overlay.is-scrolled,
  .site-header--overlay.is-open {
    background: rgba(248, 244, 237, 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
  }

  /* Mobile */
  .menu-toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-left: auto;
    margin-right: -0.5rem;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    border-radius: 50%;
  }
  .menu-toggle :global(.menu-toggle__close) {
    display: none;
  }
  .is-open .menu-toggle :global(.menu-toggle__open) {
    display: none;
  }
  .is-open .menu-toggle :global(.menu-toggle__close) {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    height: calc(100dvh - var(--header-h));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem var(--gutter) 2.5rem;
    background: var(--paper);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu.is-visible {
    opacity: 1;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu li {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.45s var(--ease);
    transition-delay: calc(var(--i) * 45ms);
  }
  .mobile-menu.is-visible li {
    opacity: 1;
    transform: none;
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.05rem 0;
    font-family: var(--font-serif);
    font-size: 2.1rem;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--saffron-deep);
  }
  .mobile-menu a[aria-current='page']::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--saffron);
  }
  .mobile-menu__foot {
    padding-top: 2rem;
    color: var(--ink-soft);
  }
  .mobile-menu__foot p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
  }
  .mobile-menu__foot a {
    display: inline-flex;
    gap: 0.5rem;
    font: 500 0.95rem var(--font-sans);
    color: var(--saffron-deep);
    padding: 0.4rem 0;
  }

  @media (max-width: 899px) {
    .site-nav,
    .site-header__ig {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
</style>
