---
import Icon from './Icon.astro';

interface Props {
  days: { day: string; stops: { name: string; note?: string }[] }[];
  note?: string;
}
const { days, note } = Astro.props;
---
{
  note && (
    <p class="itin__note">
      <Icon name="info" size={18} />
      <span>{note}</span>
    </p>
  )
}
<ol class="itin">
  {
    days.map((d) => (
      <li class="itin__day">
        <div class="itin__label">
          <span class="itin__daynum">{d.day}</span>
          <span class="itin__count">{d.stops.length} stops</span>
        </div>
        <ol class="itin__stops">
          {d.stops.map((s) => (
            <li>
              <span class="itin__dot" aria-hidden="true" />
              <h3>{s.name}</h3>
              {s.note && <p>{s.note}</p>}
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  .itin__note {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin: 1.2rem 0 1.8rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--sage-soft);
    font-size: 0.93rem;
    color: var(--ink-soft);
  }
  .itin__note :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--sage);
  }
  .itin {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .itin__day {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .itin__day {
      grid-template-columns: 130px 1fr;
      gap: 1.8rem;
      padding: 1.7rem 1.8rem;
    }
  }
  .itin__label {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  @media (min-width: 640px) {
    .itin__label {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
  .itin__daynum {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--saffron-deep);
  }
  .itin__count {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .itin__stops {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .itin__stops li {
    position: relative;
    padding: 0 0 1.3rem 1.8rem;
  }
  .itin__stops li:last-child {
    padding-bottom: 0;
  }
  .itin__stops li::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.9rem;
    bottom: -0.2rem;
    width: 1px;
    background: var(--line);
  }
  .itin__stops li:last-child::before {
    display: none;
  }
  .itin__dot {
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 4px #f6e6d4;
  }
  .itin__stops h3 {
    font-size: 1.5rem;
    margin: 0;
  }
  .itin__stops p {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
