---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import PlaceCard from '../components/PlaceCard.astro';
import PlaceFeature from '../components/PlaceFeature.astro';
import StoryCard from '../components/StoryCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { getPlaces, getStories } from '../lib/content';
import { site } from '../config/site';

const places = (await getPlaces()).slice(0, 6);
const stories = await getStories();
const featuredStories = [...stories.filter((s) => s.data.featured), ...stories.filter((s) => !s.data.featured)].slice(0, 4);
const [leadStory, ...moreStories] = featuredStories;
---
<BaseLayout>
  <!-- A. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__kicker">Sacred Places <span aria-hidden="true">·</span> Local Stories <span aria-hidden="true">·</span> Mindful Travel</p>
        <h1 id="hero-title">
          <span class="hero__line">Every journey</span> <span class="hero__line">brings you closer</span> <span class="hero__line">to something <em>deeper<svg class="hero__swash" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9 C 40 2, 120 1, 198 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg></em>.</span>
        </h1>
        <p class="hero__text">Practical guides to sacred places, local traditions, and the stories that make every journey meaningful.</p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href="/places/">Explore Places <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost btn--lg" href="/stories/">Read the Stories</a>
        </div>
      </div>

      <div class="hero__art" aria-hidden="false">
        <span class="hero__blob hero__blob--a" aria-hidden="true"></span>
        <span class="hero__blob hero__blob--b" aria-hidden="true"></span>
        <div class="hero__arch">
          <img
            src={site.hero.image}
            alt={site.hero.alt}
            style={`object-position: ${site.hero.focus}`}
            width="832"
            height="892"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <svg class="hero__dove" viewBox="0 0 64 56" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 38 C12 38 20 36 27 32.5 C33 29.5 37 25 40.5 21.5 C42.5 19.5 45 18.3 47.5 18.6 L52 19.6 L48.2 21.4 C46.5 27.5 40.5 34.5 32.5 38.3 C24.5 42 15.5 43 8.5 42.2 L0 46.5 L2.5 40.5 Z" />
          <path d="M20 34 C17.5 23 21.5 11.5 31.5 3 C32.5 13 31.5 23.5 28 32" />
          <path d="M26 33 C28 24 34 17 46 12" />
          <circle cx="45.6" cy="20.6" r="0.9" fill="currentColor" stroke="none" />
        </svg>
        <svg class="hero__leaf" viewBox="0 0 80 150" aria-hidden="true">
          <g fill="currentColor">
            <path d="M40 148 C 38 110 36 70 42 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <path d="M40 22 C 28 10 34 -2 46 2 C 52 8 48 18 40 22 Z" />
            <path d="M40 52 C 22 46 20 30 32 28 C 44 30 46 44 40 52 Z" />
            <path d="M42 56 C 56 46 70 50 70 60 C 62 68 48 66 42 56 Z" />
            <path d="M39 94 C 22 90 18 72 30 70 C 42 72 44 86 39 94 Z" />
            <path d="M40 98 C 54 88 68 92 68 102 C 60 110 46 108 40 98 Z" />
          </g>
        </svg>
        {
          site.hero.quote && (
            <figure class="hero__quote">
              <blockquote>“{site.hero.quote}”</blockquote>
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <!-- B. Introduction -->
  <section class="section intro" id="intro" aria-labelledby="intro-title">
    <div class="container intro__inner">
      <div class="intro__copy reveal">
        <span class="eyebrow">Welcome</span>
        <h2 id="intro-title">More Than Just a Journey</h2>
        <p class="lede">
          Some journeys take us to new places. Others help us see the world, and ourselves, differently. The Spiritual Dove is
          a space to explore meaningful destinations, discover the stories behind them, and reflect on the beauty of the
          journey.
        </p>
        <ul class="intro__pillars">
          <li><Icon name="compass" /><span>Sacred &amp; meaningful places</span></li>
          <li><Icon name="feather" /><span>Stories &amp; traditions</span></li>
          <li><Icon name="leaf" /><span>Reflection &amp; nature</span></li>
        </ul>
        <a class="text-link" href="/about/">About The Spiritual Dove <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- C. Featured places -->
  <section class="section section--tint" aria-labelledby="places-title">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Featured Places</span>
          <h2 id="places-title">Places That Leave a Mark</h2>
          <p>Sacred sites, heritage towns and peaceful landscapes — each with a story worth discovering.</p>
        </div>
        <div class="section-head__actions">
          {places.length > 1 && (
          <div class="carousel__nav" role="group" aria-label="Scroll places">
            <button type="button" class="carousel__btn" data-carousel-prev aria-label="Previous places">
              <Icon name="arrow-left" size={20} />
            </button>
            <button type="button" class="carousel__btn" data-carousel-next aria-label="Next places">
              <Icon name="arrow-right" size={20} />
            </button>
          </div>
          )}
          <a class="btn btn--ghost" href="/places/">View all places</a>
        </div>
      </div>
      {
        places.length === 1 ? (
          <div class="reveal">
            <PlaceFeature place={places[0]} />
            <p class="places-soon">More places are on the way. Each one gets its own itinerary, map and visitor guide.</p>
          </div>
        ) : (
          <div class="carousel" data-carousel>
            <ul class="carousel__track" data-carousel-track tabindex="0" aria-label="Featured places">
              {places.map((place) => <li class="carousel__item"><PlaceCard place={place} /></li>)}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <!-- D. Featured stories -->
  <section class="section" aria-labelledby="stories-title">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Featured Stories</span>
          <h2 id="stories-title">Notes from the Journey</h2>
          <p>Essays, reflections and cultural stories about travelling with curiosity and care.</p>
        </div>
        <a class="btn btn--ghost" href="/stories/">All stories</a>
      </div>
      {leadStory && <div class="reveal lead-story"><StoryCard story={leadStory} layout="wide" /></div>}
      {
        moreStories.length > 0 && (
          <div class="grid grid--3 more-stories">
            {moreStories.map((story) => <div class="reveal"><StoryCard story={story} /></div>)}
          </div>
        )
      }
    </div>
  </section>

  <!-- E. Reflection -->
  <section class="reflection" aria-labelledby="reflection-title">
    <div class="reflection__bg" aria-hidden="true">
      <Cover cover={{ scene: 'lamp', alt: 'An oil lamp glowing over dark water' }} ratio="auto" />
    </div>
    <div class="container reflection__inner">
      <h2 id="reflection-title" class="reveal">
        <span>Pause.</span> <span>Observe.</span> <span>Feel.</span>
      </h2>
      <p class="reflection__quote reveal">
        “Sometimes the most meaningful part of a journey is not what we see, but what we take home within us.”
      </p>
      <ol class="reflection__steps reveal">
        <li>
          <span class="reflection__num">01</span>
          <h3>Pause</h3>
          <p>Let a place arrive before rushing on. Stillness is where noticing begins.</p>
        </li>
        <li>
          <span class="reflection__num">02</span>
          <h3>Observe</h3>
          <p>Watch the rituals, rhythms and people that give a place its meaning.</p>
        </li>
        <li>
          <span class="reflection__num">03</span>
          <h3>Feel</h3>
          <p>Carry home what stays with you — a lesson, a question, a quiet sense of wonder.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- F. Newsletter -->
  <Newsletter />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const section = root.parentElement;
    const prev = section?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prev || !next) return;

    const step = () => {
      const item = track.querySelector<HTMLElement>('.carousel__item');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item ? item.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') track.scrollBy({ left: step(), behavior: 'smooth' });
      if (e.key === 'ArrowLeft') track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 7vw, 6rem);
    background:
      radial-gradient(60% 70% at 8% 80%, #f3e6d3 0%, transparent 70%),
      radial-gradient(50% 60% at 95% 10%, #f6e9d8 0%, transparent 70%),
      var(--paper);
  }
  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 1.5rem;
    }
  }
  .hero__kicker {
    margin: 0 0 1.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hero__kicker span {
    color: var(--saffron);
    margin-inline: 0.35em;
  }
  .hero h1 {
    max-width: 19ch;
    font-size: clamp(2.7rem, 1.2rem + 3.9vw, 4.6rem);
    font-weight: 500;
    line-height: 1.04;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 640px) {
    .hero__line {
      display: block;
    }
  }
  .hero h1 em {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--saffron-deep);
  }
  .hero__swash {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.16em;
    color: var(--gold);
  }
  .hero__text {
    max-width: 42ch;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 2.2rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .btn--lg {
    min-height: 56px;
    padding-inline: 2rem;
    font-size: 1.02rem;
  }
  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Hero artwork: photograph inside an arch, with soft shapes, a dove, a sprig and a quote */
  .hero__art {
    position: relative;
    width: min(100%, 520px);
    margin-inline: auto;
    padding: 2.5rem 2rem 1rem 2.5rem;
  }
  @media (min-width: 960px) {
    .hero__art {
      margin-right: 0;
    }
  }
  .hero__arch {
    position: relative;
    z-index: 1;
    aspect-ratio: 832 / 892;
    overflow: hidden;
    border-radius: 999px 999px 8px 8px;
    box-shadow: 0 30px 60px -30px rgba(80, 50, 30, 0.45);
  }
  .hero__arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-settle 1.6s var(--ease) both;
  }
  @keyframes hero-settle {
    from { transform: scale(1.06); opacity: 0.6; }
    to { transform: scale(1); opacity: 1; }
  }
  .hero__blob {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
  }
  .hero__blob--a {
    width: 62%;
    aspect-ratio: 1;
    left: -4%;
    top: 22%;
    background: #f4e3cc;
  }
  .hero__blob--b {
    width: 52%;
    aspect-ratio: 1;
    right: -2%;
    top: 6%;
    background: #f3dcc3;
    opacity: 0.8;
  }
  .hero__dove {
    position: absolute;
    z-index: 2;
    left: -9%;
    top: 14%;
    width: 27%;
    color: var(--saffron-deep);
    opacity: 0.85;
    animation: dove-float 7s ease-in-out infinite;
  }
  @keyframes dove-float {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-8px) rotate(1deg); }
  }
  .hero__leaf {
    position: absolute;
    z-index: 2;
    right: -3%;
    top: 12%;
    width: 15%;
    color: #7e8f74;
    opacity: 0.9;
    transform: rotate(18deg);
  }
  .hero__quote {
    position: absolute;
    z-index: 3;
    left: -2%;
    bottom: 9%;
    width: 40%;
    margin: 0;
    padding: 1.2rem 1.2rem 1.4rem;
    border-radius: 14px;
    background: rgba(255, 253, 249, 0.92);
    backdrop-filter: blur(6px);
    box-shadow: 0 18px 40px -18px rgba(80, 50, 30, 0.35);
  }
  .hero__quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.4rem);
    line-height: 1.35;
    color: var(--ink-soft);
  }
  .hero__quote::after {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    margin-top: 0.9rem;
    background: var(--gold);
  }
  @media (max-width: 559px) {
    .hero__art {
      padding: 1.5rem 1rem 0.5rem 1.2rem;
    }
    .hero__quote {
      width: 52%;
      left: 0;
      bottom: 4%;
      padding: 0.9rem 0.9rem 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__dove,
    .hero__arch img {
      animation: none;
    }
  }

  /* Intro */
  .intro__inner {
    max-width: 980px;
    text-align: center;
  }
  .intro .eyebrow {
    justify-content: center;
  }
  .intro .lede {
    max-width: 60ch;
    margin-inline: auto;
  }
  .intro__pillars {
    list-style: none;
    padding: 0;
    margin: 2.4rem 0 2.6rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2.2rem;
  }
  .intro__pillars li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-soft);
  }
  .intro__pillars :global(svg) {
    flex: none;
    width: 40px;
    height: 40px;
    padding: 9px;
    border-radius: 50%;
    background: var(--sage-soft);
    color: var(--sage);
  }

  .places-soon {
    margin: 1.4rem 0 0;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ink-soft);
  }

  /* Featured places carousel */
  .section-head__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
  }
  .carousel__nav {
    display: flex;
    gap: 0.5rem;
  }
  .carousel__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .carousel__btn:hover:not(:disabled) {
    background: var(--ink);
    color: var(--white);
  }
  .carousel__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .carousel__track {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1.5rem;
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__item {
    flex: 0 0 min(84%, 380px);
    scroll-snap-align: start;
    display: flex;
  }
  .carousel__item > :global(*) {
    flex: 1;
    min-width: 0;
  }

  /* Stories */
  .lead-story:not(:last-child) {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  /* Reflection */
  .reflection {
    position: relative;
    isolation: isolate;
    color: var(--white);
    padding-block: clamp(5rem, 12vw, 9rem);
    text-align: center;
    overflow: hidden;
    background: var(--dusk);
  }
  .reflection__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.9;
  }
  .reflection__bg :global(.cover) {
    height: 100%;
  }
  .reflection__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 31, 58, 0.5), rgba(28, 31, 58, 0.7) 60%, rgba(28, 31, 58, 0.85));
  }
  .reflection h2 {
    color: var(--white);
    font-size: clamp(2.8rem, 1.5rem + 6vw, 6.5rem);
    font-weight: 400;
    font-style: italic;
    margin-bottom: 0.4em;
  }
  .reflection h2 span:nth-child(2) { color: #f3c99c; }
  .reflection__quote {
    max-width: 34ch;
    margin: 0 auto 4rem;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.4;
    color: rgba(255, 253, 249, 0.88);
  }
  .reflection__steps {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    max-width: 1000px;
    text-align: left;
  }
  @media (min-width: 800px) {
    .reflection__steps { grid-template-columns: repeat(3, 1fr); }
  }
  .reflection__steps li {
    padding: 1.8rem;
    border-radius: var(--radius);
    background: rgba(255, 253, 249, 0.06);
    border: 1px solid rgba(255, 253, 249, 0.14);
    backdrop-filter: blur(6px);
  }
  .reflection__num {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: #f3c99c;
  }
  .reflection__steps h3 {
    color: var(--white);
    font-size: 1.9rem;
    margin: 0.5rem 0 0.4rem;
  }
  .reflection__steps p {
    margin: 0;
    color: rgba(255, 253, 249, 0.75);
    font-size: 0.97rem;
  }
</style>
